## Frontend (Vite) environment variables
#
# Local backend (Express):
# VITE_API_BASE_URL=http://localhost:3000
#
# If the backend is deployed on the SAME domain as the frontend (e.g. Vercel rewrite to /api),
# you can leave this unset to use same-origin `/api`.
#
# If the backend is deployed separately:
# VITE_API_BASE_URL=https://your-backend-domain.com

VITE_API_URL=http://localhost:3000

# Firebase web app config for Visual Attention reports (read-only)
# Replace with your Firebase project's web config (from Firebase console)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_app_id_here

